
PORT=5000
NODE_ENV=development

# MongoDB
# Local default. If nothing is listening on 27017 in development, the
# server starts an in-memory database so `npm run dev` still boots.
MONGODB_URI=mongodb://127.0.0.1:27017/swasthyasetu

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# Cloudinary (for document storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenRouter (LLM)
OPENROUTER_API_KEY=your_openrouter_api_key

# ABDM Sandbox
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway


ML_SERVICE_URL=http://localhost:8000

# Allowed browser origins, comma-separated (patient kiosk + doctor portal)
CLIENT_URL=http://localhost:5173,http://localhost:5174
